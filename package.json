{
  "name": "medical-form-printer",
  "version": "0.3.0",
  "description": "A medical form print renderer - render structured form data to printable HTML/PDF",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangchengshi-ship-it/medical-form-printer.git"
  },
  "homepage": "https://github.com/wangchengshi-ship-it/medical-form-printer#readme",
  "bugs": {
    "url": "https://github.com/wangchengshi-ship-it/medical-form-printer/issues"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage",
    "test:ui": "npx vitest --ui",
    "test:storybook": "npx vitest --project=storybook",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build",
    "chromatic": "npx chromatic --project-token=chpt_d07c2959b534f43"
  },
  "keywords": [
    "medical",
    "form",
    "print",
    "pdf",
    "renderer",
    "healthcare",
    "emr",
    "html-to-pdf",
    "medical-records",
    "document-generation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/html": "^10.1.11",
    "@storybook/html-vite": "^10.1.11",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.19.27",
    "@types/puppeteer": "^5.4.7",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-istanbul": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "chromatic": "^13.3.4",
    "eslint": "^8.57.1",
    "fast-check": "^3.23.2",
    "jsdom": "^24.1.3",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "^10.1.11",
    "subset-font": "^2.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "esbuild": "^0.27.2",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "puppeteer": "^21.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.54.0"
  }
}
